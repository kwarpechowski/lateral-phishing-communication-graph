\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-B}}Cross-layer inconsistency as a mechanism}{3}{}\protected@file@percent }
\newlabel{sec:mechanism}{{\mbox  {V-B}}{3}{}{subsection.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The case-study organization, drawn from the population data: $19$~firms on a ring of business partnerships, $150$~accounts colored by seniority, and the real contacts layer ($556$~edges). Overlaid are the two cases the detector must separate: an external impersonation from outside every layer ($C(s,v){=}0$), and a legitimate new sender connected only through a shared OSINT layer (the same conference), which must not be flagged.}}{4}{}\protected@file@percent }
\newlabel{fig:casestudy}{{1}{4}{}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Cross-layer inconsistency on the case-study graph ($20$~seeds): fusing the layers with the rhythm lifts AUC from $0.70$ to $0.87$ and removes every new-sender false alarm; the shuffle control falls to chance.}}{4}{}\protected@file@percent }
\newlabel{tab:inv1}{{II}{4}{}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cumulative layer ablation: the eight OSINT layers add little on top of contacts ($0.57\!\to \!0.65$) and the temporal-consistency feature carries the bulk of the signal ($\to \!0.86$).}}{4}{}\protected@file@percent }
\newlabel{fig:ablation}{{2}{4}{}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Topology decorrelation ($20$~seeds): rewiring contacts across companies lowers the overlap of the structural layers and raises their independent contribution.}}{5}{}\protected@file@percent }
\newlabel{tab:topo}{{III}{5}{}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Group ablation per threat. Left: new senders: OSINT is critical, time is useless. Right: compromises: the reverse. Each layer family is critical for its own failure mode.}}{5}{}\protected@file@percent }
\newlabel{fig:bythreat}{{3}{5}{}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-C}}The real Enron multiplex and the rhythm-leak pitfall}{5}{}\protected@file@percent }
\newlabel{sec:enron}{{\mbox  {V-C}}{5}{}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Rhythm-leak control on the real Enron graph ($20$~seeds): estimating the rhythm on the full history inflates the temporal layer to an apparent sensitivity of $0.73$; a proper temporal split drops it to $0.00$, while the full multiplex keeps $0.51$.}}{5}{}\protected@file@percent }
\newlabel{tab:enronsplit}{{IV}{5}{}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Enron anchor audit. AUC (left) degrades gently with the off-hours traffic fraction; the operational sensitivity at FPR~$1\%$ (right) was inflated: the temporal layer alone collapses to zero, and the multiplex advantage rises with the off-hours fraction.}}{5}{}\protected@file@percent }
\newlabel{fig:enronaudit}{{4}{5}{}{figure.4}{}}
