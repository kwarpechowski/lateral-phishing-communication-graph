\@nameuse{bbl@beforestart}
\babel@aux{english}{}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Detector hyperparameters: fixed \emph  {uniformly} for all models of a given family, framework defaults or lightly chosen, without grid search.}}{1}{}\protected@file@percent }
\newlabel{stab:hparams}{{S1}{1}{}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Detector hierarchy on AUC (left) and sensitivity@FPR1\% (right); values as in the cascade-detector table of the main text. The temporal GNN dominates; time shuffling (red) levels it with the static GNN.}}{1}{}\protected@file@percent }
\newlabel{sfig:detectors}{{S1}{1}{}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Cascade model sweep (AUC, depth~$4$, $8$~seeds): the hierarchy holds across the whole range of the infection probability, and the receiving-side signal does not vanish at a realistically low $p_\mathrm  {inf}$.}}{2}{}\protected@file@percent }
\newlabel{stab:pinf}{{S2}{2}{}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Inductive validation on unseen organizations ($19$~organizations: $5$~seeds; $30$ and $200$~organizations: $3$~seeds): the temporal detector's operational advantage over the hand-crafted context holds on companies never seen in training, but shrinks with scale ($4.4\times \!\to \!1.4\times $).}}{3}{}\protected@file@percent }
\newlabel{stab:scale}{{S3}{3}{}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Inductive validation: sensitivity@FPR1\% on unseen organizations against the number of companies (values as in Tab.~S3). The advantage holds inductively but decreases ($4.4\times \!\to \!1.4\times $).}}{3}{}\protected@file@percent }
\newlabel{sfig:scale}{{S2}{3}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Two real topologies (\texttt  {email-Eu-core}, \texttt  {CollegeMsg}). The volume detector (red) wins the naive blast, but breaks down under the stealthy attack; the temporal GNN (blue) maintains its effectiveness. Values as in block~(b) of the real-graph table of the main text.}}{4}{}\protected@file@percent }
\newlabel{sfig:realgraphs}{{S3}{4}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces The cascade invariant on Enron (values as in block~(a) of the real-graph table of the main text): the same hierarchy as on the case-study graph (1-hop $<$ hand-crafted context $<$ temporal GNN), with the time shuffle leveling the temporal detector to the hand-crafted result.}}{4}{}\protected@file@percent }
\newlabel{sfig:enroncasc}{{S4}{4}{}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Audit of noisy training labels (AUC, stealthy attack; $20$~seeds): the learned temporal model degrades fastest, so its advantage shrinks under realistic label noise.}}{5}{}\protected@file@percent }
\newlabel{stab:labelnoise}{{S4}{5}{}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Sensitivity--FPR curve ($10$~seeds). At low FPR all methods are weak; the volume detector dominates the blast and breaks down under the stealthy attack, where the receiving-side signal holds.}}{5}{}\protected@file@percent }
\newlabel{sfig:fpr}{{S5}{5}{}{figure.5}{}}
